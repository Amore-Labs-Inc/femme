[Unit]
Description=FEMME auto-rotate on account-wide 5h/7d caps: hold accounts past their caps out of rotation and move off them
After=femme-cswap.service

[Service]
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/femme/server/fable-cap.sh
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
