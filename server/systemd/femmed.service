[Unit]
Description=FEMME daemon: sessions, agents, the board and the API (localhost; Caddy serves it over HTTPS)
After=network-online.target

[Service]
Type=notify
EnvironmentFile=%h/femme/.env
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUST_LOG=info
ExecStart=%h/.local/bin/femmed serve
# femmed pings the watchdog from its main loop; a wedged daemon is restarted, its sessions are not
# touched: they run as femme-holder units in femme-sessions.slice and femmed reconnects to them.
# 60 s, not 10: a box deep in swap stalled a healthy daemon's ping past 10 s, and every restart
# re-read the mirrored transcripts, which kept it in swap (seven kills in a row on 2026-11-09).
WatchdogSec=60
Restart=always
RestartSec=1
CPUWeight=500
# The daemon's pages stay in RAM when the box swaps (2026-11-09: agents' builds pushed 4 GB into
# swap, femmed went with them and missed its watchdog), and the OOM killer takes it last.
MemoryMin=1G
MemoryLow=2G
OOMScoreAdjust=-900

[Install]
WantedBy=default.target
