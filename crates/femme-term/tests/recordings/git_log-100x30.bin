[33mcommit ea86f0aaa6722aec35fb2a38607b7519f5005c23[m[33m ([m[1;36mHEAD[m[33m -> [m[1;32mmain[m[33m, [m[1;31morigin/main[m[33m, [m[1;31morigin/HEAD[m[33m)[m
Author: Jane Doe <jane@example.com>  
Date:   Fri Oct 30 18:59:12 2026 +0300

    install.sh: say when it is checking the sudo account, and fail fast when unreachable
    
    The ssh check ran silently for up to 20 s, which looked like a hang; an unreachable
    host also went on to ssh-copy-id. Now it prints what it checks, says why it failed,
    and only offers the password route when ssh got as far as Permission denied.
    
    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[1mdiff --git a/install.sh b/install.sh[m
[1mindex cdf3ca7..cea1670 100755[m
[1m--- a/install.sh[m
[1m+++ b/install.sh[m
[36m@@ -66,7 +66,13 @@[m [mis_emails() {  # comma-separated; also catches keyboard escapes (Option+Q for @[m
 is_admin() {  # user@address, and this laptop's key logs in there[m
   case $1 in *@?*) ;; *) warn "  as user@address, e.g. ubuntu@203.0.113.7"; return 1 ;; esac[m
   case ${1#*@} in 203.0.113.*) warn "  that is the example address: use your server's"; return 1 ;; esac[m
[31m-  ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$1" true 2>/dev/null && return[m
[32m+[m[32m  local err[m
[32m+[m[32m  printf '  checking %s over ssh…\n' "$1" >&2[m
[32m+[m[32m  err=$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$1" true 2>&1 | tr -d '\r' | tail -n 1; exit "${PIPESTATUS[0]}") && return[m
[32m+[m[32m  case $err in[m
[32m+[m[32m    *"Permission denied"*) ;;[m
[32m+[m[32m    *) warn "  could not reach ${1#*@} over ssh (${err##*: }): check the address"; return 1 ;;[m
[32m+[m[32m  esac[m
   # Many VPSs start with a password: put the key there once, so every later step logs in without one.[m
   warn "  ~/.ssh/id_ed25519 does not log in to $1 yet; if it takes a password, enter it once to add the key"[m
   ssh-copy-id -i ~/.ssh/id_ed25519.pub -o ConnectTimeout=10 "$1" >/dev/null 2>&1 </dev/tty \[m

[33mcommit 7c001a31ee1ae8587370fd080e8cae30ee32f35a[m
Author: Jane Doe <jane@example.com>  
Date:   Fri Oct 30 18:56:36 2026 +0300

    install.sh: read Option+Q as @ when the terminal sends it as Esc q
    
    On Turkish and other layouts @ is Option+Q; with Terminal's "Use Option as Meta key"
    on, that arrives as Esc q and no email address could be typed.
    
    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[1mdiff --git a/install.sh b/install.sh[m
[1mindex 9917046..cdf3ca7 100755[m
[1m--- a/install.sh[m
[1m+++ b/install.sh[m
[36m@@ -41,6 +41,8 @@[m [mask() {  # KEY "question" [secret] [check]: keeps the current value on Enter; as[m
       read -r -p "$2 [${cur}]: " v[m
     fi[m
     v=${v:-$cur}[m
[32m+[m[32m    # Option+Q is @ on Turkish and other layouts; with "Use Option as Meta key" the terminal sends Esc q.[m
[32m+[m[32m    v=${v//$'\x1b'q/@}[m
     [ -z "${4:-}" ] || "$4" "$v" || continue[m
     break[m
   done[m

