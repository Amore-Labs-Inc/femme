[1mindex abb4323..b92305b 100644[m
[1m--- a/laptop/lib.sh[m
[1m+++ b/laptop/lib.sh[m
[36m@@ -61,11 +61,14 @@[m [mchoose() {[m
     [ "$cur" -ge 1 ] && [ "$cur" -le $n ] || die "pick a number from 1 to $n"[m
     eval "$var=\$cur"; return[m
   fi[m
[32m+[m[32m  # One screen line per option, or redrawing in place drifts: cut what the terminal is too narrow for.[m
[32m+[m[32m  local w; w=$(( $(tput cols 2>/dev/null || echo 80) - 6 ))[m
   printf '\033[?25l' >&2[m
