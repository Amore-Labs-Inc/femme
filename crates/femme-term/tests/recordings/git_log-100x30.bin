[32m+[m[32m# Pick one of several options with the arrow keys (or j/k, or its number) and Enter.[m
[32m+[m[32m# Usage: choose VAR "question" "option 1" "option 2" ...   VAR gets the number picked, from 1.[m
[32m+[m[32m# Without a terminal (piped answers) it reads the number instead.[m
[32m+[m[32mchoose() {[m
[32m+[m[32m  local var=$1 q=$2 cur=1 key rest i n; shift 2; n=$#[m
[32m+[m[32m  printf '%s\n' "$q" >&2[m
[32m+[m[32m  if [ ! -t 0 ] || [ ! -t 2 ]; then[m
[32m+[m[32m    i=0; for o in "$@"; do i=$((i + 1)); printf '  %d) %s\n' $i "$o" >&2; done[m
[32m+[m[32m    read -r -p "1-$n: " cur[m
[32m+[m[32m    case $cur in ''|*[!0-9]*) die "pick a number from 1 to $n" ;; esac[m
[32m+[m[32m    [ "$cur" -ge 1 ] && [ "$cur" -le $n ] || die "pick a number from 1 to $n"[m
[32m+[m[32m    eval "$var=\$cur"; return[m
[32m+[m[32m  fi[m
[32m+[m[32m  printf '\033[?25l' >&2[m
[32m+[m[32m  while :; do[m
[32m+[m[32m    i=0[m
[32m+[m[32m    for o in "$@"; do[m
[32m+[m[32m      i=$((i + 1))[m
[32m+[m[32m      if [ $i = "$cur" ]; then printf '\r\033[K  \033[36m❯ %s\033[0m\n' "$o" >&2; else printf '\r\033[K    \033[2m%s\033[0m\n' "$o" >&2; fi[m
[32m+[m[32m    done[m
[32m+[m[32m    IFS= read -rsn1 key[m
[32m+[m[32m    case $key in[m
[32m+[m[32m      $'\x1b') read -rsn2 rest; case $rest in '[A') key=k ;; '[B') key=j ;; esac ;;[m
[32m+[m[32m    esac[m
[32m+[m[32m    case $key in[m
[32m+[m[32m      k) [ "$cur" -gt 1 ] && cur=$((cur - 1)) ;;[m
[32m+[m[32m      j) [ "$cur" -lt $n ] && cur=$((cur + 1)) ;;[m
[32m+[m[32m      [1-9]) [ "$key" -le $n ] && cur=$key ;;[m
[32m+[m[32m      '') break ;;[m
[32m+[m[32m    esac[m
[32m+[m[32m    printf '\033[%dA' $n >&2[m
[32m+[m[32m  done[m
[32m+[m[32m  printf '\033[?25h' >&2[m
[32m+[m[32m  eval "$var=\$cur"[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m# Run a long step quietly: its output goes to $LOG, a spinner and the time show meanwhile, and a[m
[32m+[m[32m# failure prints the end of the log. Usage: step "what it does" command args...[m
[32m+[m[32mstep() {[m
[32m+[m[32m  local msg=$1 pid t0=$SECONDS i=0 s='|/-\'; shift[m
[32m+[m[32m  printf '\n== %s\n' "$msg" >> "$LOG"[m
[32m+[m[32m  "$@" >> "$LOG" 2>&1 < /dev/null &[m
[32m+[m[32m  pid=$![m
[32m+[m[32m  if [ -t 2 ]; then[m
[32m+[m[32m    while kill -0 $pid 2>/dev/null; do[m
[32m+[m[32m      printf '\r\033[K  %s %s \033[2m%ds\033[0m' "${s:$((i % 4)):1}" "$msg" $((SECONDS - t0)) >&2[m
[32m+[m[32m      i=$((i + 1)); sleep 1[m
[32m+[m[32m    done[m
[32m+[m[32m  fi[m
[32m+[m[32m  if wait $pid; then[m
[32m+[m[32m    printf '\r\033[K  \033[32m✓\033[0m %s \033[2m%ds\033[0m\n' "$msg" $((SECONDS - t0)) >&2[m
[32m+[m[32m  else[m
[32m+[m[32m    printf '\r\033[K  \033[31m✗\033[0m %s\n' "$msg" >&2[m
[32m+[m[32m    tail -n 30 "$LOG" >&2[m
[32m+[m[32m    die "That step failed; the whole log is in $LOG"[m
[32m+[m[32m  fi[m
[32m+[m[32m}[m

[33mcommit 43ecf49a822c6e372447e15864797e1be88eedd1[m
Author: Jane Doe <jane@example.com>  
Date:   Fri Oct 30 18:27:16 2026 +0300

    bootstrap: work on a fresh box without herdr config or python3-venv
    
    Create ~/.config/herdr before writing config.toml (absent when the laptop has
    no herdr config to sync), and install python3-venv when ensurepip is missing,
    so cswap's venv builds on a stock Ubuntu 24.04.
    
    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[1mdiff --git a/server/bootstrap.sh b/server/bootstrap.sh[m
[1mindex 862271c..5262565 100755[m
[1m--- a/server/bootstrap.sh[m
[1m+++ b/server/bootstrap.sh[m
[36m@@ -40,6 +40,7 @@[m [msudo ln -sf ~/.local/bin/herdr /usr/local/bin/herdr[m
 mkdir -p ~/.codex ~/.pi/agent ~/.config/opencode[m
 for a in claude codex pi opencode; do herdr integration install "$a" || echo "WARN: $a integration failed" >&2; done[m
 [m
[32m+[m[32mmkdir -p ~/.config/herdr  # absent when the laptop has no herdr config to sync[m
 grep -q '^\[experimental\]' ~/.config/herdr/config.toml 2>/dev/null \[m
   || printf '\n[experimental]\n# single-user box: keep screen history across reboots\npane_history = true\n' >> ~/.config/herdr/config.toml[m
 [m
[36m@@ -112,6 +113,8 @@[m [mif [ -n "${BOARD_URL:-}" ]; then[m
   cp board/target/release/femme-board ~/.local/bin/femme-board.new[m
   mv ~/.local/bin/femme-board.new ~/.local/bin/femme-board[m
   # cswap: the board's accounts window and femme-cswap's auto-rotation. Its own venv, pinned.[m
[32m+[m[32m  # Ubuntu ships python3 without venv's ensurepip.[m
[32m+[m[32m  python3 -c 'import ensurepip' 2>/dev/null || { sudo apt-get update -qq && sudo apt-get install -y -qq python3-venv; }[m
   ~/.local/share/cswap/bin/cswap --version >/dev/null 2>&1 \[m
     || { python3 -m venv --clear ~/.local/share/cswap && ~/.local/share/cswap/bin/pip install -q claude-swap==0.27.2; }[m
   ln -sf ~/.local/share/cswap/bin/cswap ~/.local/bin/cswap[m
